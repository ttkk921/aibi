# 复制到项目根目录：cp deploy/docker/.env.example .env，然后按注释填写。
# 这个文件里有密码和 key，不要提交到 git（.gitignore 已忽略 .env）。

# ---- 访问域名：Caddy 自动申请和续期 HTTPS 证书（域名要先解析到这台服务器，80/443 端口要放行）
DOMAIN=bi.example.com

# ---- 数据库（自带的 MySQL 容器；用客户已有的库见 deploy/docker/README.md）
MYSQL_ROOT_PASSWORD=请改成随机强密码
DB_NAME=bi_data
DB_USER=bi
DB_PASSWORD=请改成另一个随机强密码

# ---- AI 问数：OpenAI 兼容接口，默认 Command Code
COMMANDCODE_API_KEY=
# LLM_MODEL=deepseek/deepseek-v4.1-flash-fast
# LLM_BASE_URL=https://api.commandcode.ai/provider/v1

# ---- 业务包：默认用镜像里的 packages/retail；客户自己的业务包见 README
# BI_PACKAGE_DIR=/app/packages/retail

# ---- 第一个管理员的用户名（密码由系统生成，首次启动时打印在日志里）
# ADMIN_USER=admin

# ---- 国内服务器建议换成国内源（构建镜像时用）
PIP_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
NPM_REGISTRY=https://registry.npmmirror.com
# MYSQL_IMAGE=mysql:8.4.3
