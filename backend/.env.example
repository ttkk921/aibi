# Copy to backend/.env (never commit .env). Login fields are created by: uv run python -m app.cli init
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=
DB_PASSWORD=
DB_NAME=bi_data
# ADMIN_USER / ADMIN_PASSWORD_HASH / SECRET_KEY are written by `app.cli init`
# COOKIE_SECURE=1   # only when served over HTTPS
# Read-only query API for AI agents (/api/agent), see docs/bi-agent.md
# AGENT_TOKEN_HASH is written by `python -m app.cli agent-token <token file>`
# AGENT_DB_USER=bi_ai_ro        # SELECT-only account, no access to account_no
# AGENT_DB_PASSWORD=
# AGENT_ALLOW_REMOTE=0          # 1 = also serve requests coming through nginx
# AI 问数 (/api/chat): OpenAI-compatible endpoint; defaults to Command Code + DeepSeek V4.1 Flash
# COMMANDCODE_API_KEY=            # or LLM_API_KEY
# LLM_BASE_URL=https://api.commandcode.ai/provider/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4.1-flash-fast,deepseek/deepseek-v4-pro   # AI 设置页的初始模型列表
